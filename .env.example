# Google Maps API Key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE

# Django Secret Key & Debug
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app

# Supabase Database URL (get from: Supabase Dashboard > Project Settings > Database > URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# SSLCommerz Payment Gateway Configuration
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_IS_SANDBOX=True
BACKEND_BASE_URL=https://your-app.up.railway.app

